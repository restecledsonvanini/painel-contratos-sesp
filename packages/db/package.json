{
  "name": "@painel/db",
  "version": "0.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "migrate:create": "npx prisma migrate dev --schema=./prisma/schema.prisma --create-only --name init",
    "migrate:deploy": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "seed": "tsx ./seed_supabase.ts"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.2"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  }
}
