// Prisma schema — Postgres local (Docker) / staging
// Migrations: packages/db/prisma/migrations (Prisma Migrate format)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum TipoOrgao {
  POLICIA_MILITAR
  POLICIA_CIVIL
  BOMBEIROS
  POLICIA_PENAL
  POLICIA_CIENTIFICA
  TRANSITO
  ADMINISTRACAO_DIRETA
}

enum NivelUnidade {
  COMANDO_GERAL
  DIRETORIA
  COMANDO_REGIONAL
  BATALHAO
  COMPANHIA
  DELEGACIA
  UNIDADE_PRISIONAL
  SETOR
}

enum TipoPessoa {
  JURIDICA
  FISICA
}

enum PorteEmpresa {
  MEI
  ME
  EPP
  DEMAIS
}

enum SituacaoFornecedor {
  ATIVO
  INATIVO
  IMPEDIDO
  INIDONEO
}

enum TipoSancao {
  ADVERTENCIA
  MULTA
  IMPEDIMENTO_LICITAR
  DECLARACAO_INIDONEIDADE
}

model UnidadeFsp {
  id        String     @id @default(uuid())
  sigla     String     @unique
  nome      String
  contratos Contrato[]
}

model Municipio {
  id                   String                  @id @default(uuid())
  codigoIbge           String                  @unique
  nome                 String
  uf                   String
  regiaoAdministrativa String?
  unidades             UnidadeOrganizacional[]
  fornecedores         Fornecedor[]

  @@index([uf, nome])
}

model Dominio {
  id                  String         @id @default(uuid())
  slug                String         @unique
  nome                String
  descricao           String?
  editavelPeloUsuario Boolean        @default(true)
  permiteHierarquia   Boolean        @default(false)
  valores             DominioValor[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model DominioValor {
  id           String         @id @default(uuid())
  dominioId    String
  dominio      Dominio        @relation(fields: [dominioId], references: [id], onDelete: Cascade)
  codigo       String
  label        String
  parentId     String?
  parent       DominioValor?  @relation("DominioValorHierarquia", fields: [parentId], references: [id])
  children     DominioValor[] @relation("DominioValorHierarquia")
  ordem        Int            @default(0)
  ativo        Boolean        @default(true)
  metadata     Json?
  codigoLegado String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([dominioId, codigo])
  @@index([dominioId, ativo, ordem])
  @@index([parentId])
}

model Orgao {
  id        String                  @id @default(uuid())
  sigla     String                  @unique
  nome      String
  tipo      TipoOrgao
  ativo     Boolean                 @default(true)
  unidades  UnidadeOrganizacional[]
  servidores Servidor[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
}

model UnidadeOrganizacional {
  id          String                  @id @default(uuid())
  orgaoId     String
  orgao       Orgao                   @relation(fields: [orgaoId], references: [id])
  parentId    String?
  parent      UnidadeOrganizacional?  @relation("UnidadeHierarquia", fields: [parentId], references: [id])
  children    UnidadeOrganizacional[] @relation("UnidadeHierarquia")
  sigla       String
  nome        String
  nivel       NivelUnidade
  municipioId String
  municipio   Municipio               @relation(fields: [municipioId], references: [id])
  ativo       Boolean                 @default(true)
  servidores  Servidor[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([orgaoId, sigla])
  @@index([parentId])
  @@index([municipioId])
  @@index([orgaoId, ativo])
}

model Fornecedor {
  id                 String              @id @default(uuid())
  tipoPessoa         TipoPessoa          @default(JURIDICA)
  documento          String              @unique
  razaoSocial        String
  nomeFantasia       String?
  inscricaoEstadual  String?
  porte              PorteEmpresa?
  municipioId        String?
  municipio          Municipio?          @relation(fields: [municipioId], references: [id])
  situacao           SituacaoFornecedor  @default(ATIVO)
  codigoLegado       String?
  contatos           FornecedorContato[]
  sancoes            FornecedorSancao[]
  contratos          Contrato[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([razaoSocial])
  @@index([situacao])
}

model FornecedorContato {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  cargo        String?
  email        String?
  telefone     String?
  principal    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
}

model FornecedorSancao {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  tipo         TipoSancao
  processo     String?
  dataInicio   DateTime   @db.Date
  dataFim      DateTime?  @db.Date
  abrangencia  String?
  fonte        String?
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
  @@index([dataFim])
}

model Servidor {
  id          String                 @id @default(uuid())
  nome        String
  cpf         String?                @unique
  rgFuncional String?                @unique
  cargo       String?
  orgaoId     String?
  orgao       Orgao?                 @relation(fields: [orgaoId], references: [id])
  unidadeId   String?
  unidade     UnidadeOrganizacional? @relation(fields: [unidadeId], references: [id])
  email       String?
  telefone    String?
  ativo       Boolean                @default(true)
  gestorContratos Contrato[]         @relation("gestorContratos")
  fiscalContratos Contrato[]         @relation("fiscalContratos")
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([nome])
  @@index([orgaoId])
}

model Contrato {
  id              String     @id @default(uuid())
  protocoloCabeca String?    @unique
  numGms          Int
  anoGms          Int
  unidadeFspId    String
  unidadeFsp      UnidadeFsp @relation(fields: [unidadeFspId], references: [id])
  gestorId        String
  gestor          Servidor   @relation("gestorContratos", fields: [gestorId], references: [id])
  fiscalId        String
  fiscal          Servidor   @relation("fiscalContratos", fields: [fiscalId], references: [id])
  fornecedorId    String
  fornecedor      Fornecedor @relation(fields: [fornecedorId], references: [id])
  modalidade      String
  objeto          String
  valorAnualCents Int
  dataInicio      DateTime?  @db.Date
  dataFimOrig     DateTime?  @db.Date
  status          String
  aditivos        Aditivo[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([numGms, anoGms])
  @@index([dataFimOrig])
  @@index([unidadeFspId])
  @@index([fornecedorId])
}

model Aditivo {
  id                  String    @id @default(uuid())
  contratoId          String
  contrato            Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  numAditivo          Int
  protocoloAdit       String
  novoFimVigencia     DateTime? @db.Date
  valorAdicionalCents Int?
  createdAt           DateTime  @default(now())
}

model Servico {
  id        String   @id @default(uuid())
  titulo    String
  descricao String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  tabela     String
  registroId String
  action     String
  diff       Json
  changedBy  String?
  source     String?
  changedAt  DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  sub       String?  @unique
  email     String?  @unique
  role      String   @default("colaborador")
  createdAt DateTime @default(now())
}
