// Prisma schema — Postgres local (Docker) / staging
// Client: Prisma 7.10 (adapter-pg). URL e paths de migrate ficam em prisma.config.ts.
// Migrations: packages/db/prisma/migrations (Prisma Migrate format)

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

enum TipoOrgao {
  POLICIA_MILITAR
  POLICIA_CIVIL
  BOMBEIROS
  POLICIA_PENAL
  POLICIA_CIENTIFICA
  TRANSITO
  ADMINISTRACAO_DIRETA
}

enum NivelUnidade {
  COMANDO_GERAL
  DIRETORIA
  COMANDO_REGIONAL
  BATALHAO
  COMPANHIA
  DELEGACIA
  UNIDADE_PRISIONAL
  SETOR
}

enum TipoPessoa {
  JURIDICA
  FISICA
}

enum PorteEmpresa {
  MEI
  ME
  EPP
  DEMAIS
}

enum SituacaoFornecedor {
  ATIVO
  INATIVO
  IMPEDIDO
  INIDONEO
}

enum TipoSancao {
  ADVERTENCIA
  MULTA
  IMPEDIMENTO_LICITAR
  DECLARACAO_INIDONEIDADE
}

enum PilarOrcamentario {
  CUSTEIO
  INVESTIMENTO
  SERVICOS
}

enum NaturezaObjeto {
  SERVICO_CONTINUADO
  SERVICO_NAO_CONTINUADO
  OBRA
  SERVICO_ENGENHARIA
  COMPRA
  LOCACAO_BEM_MOVEL
  LOCACAO_IMOVEL
  SOLUCAO_TIC
}

enum SituacaoContrato {
  EM_ELABORACAO
  ASSINADO
  VIGENTE
  SUSPENSO
  RESCINDIDO
  ENCERRADO
  ANULADO
}

enum UnidadeTempo {
  DIAS
  MESES
  ANOS
}

enum TipoGarantia {
  NENHUMA
  CAUCAO
  SEGURO_GARANTIA
  FIANCA_BANCARIA
}

enum PapelResponsavel {
  GESTOR
  GESTOR_SUBSTITUTO
  FISCAL_TECNICO
  FISCAL_ADMINISTRATIVO
  FISCAL_SETORIAL
  FISCAL_SUBSTITUTO
  PREPOSTO_CONTRATADA
}

enum SituacaoProcesso {
  PLANEJAMENTO
  EM_ANALISE_JURIDICA
  EM_LICITACAO
  HOMOLOGADO
  CONTRATADO
  FRACASSADO
  DESERTO
  CANCELADO
}

enum Periodicidade {
  UNICA
  DIARIA
  MENSAL
  ANUAL
}

enum TipoAtributo {
  TEXTO
  TEXTO_LONGO
  NUMERO
  MOEDA
  DATA
  BOOLEANO
  SELECAO
  MULTI_SELECAO
  MUNICIPIO
  UNIDADE
}

enum TipoAlteracao {
  ADITIVO_PRAZO
  ADITIVO_ACRESCIMO_QUANTITATIVO
  ADITIVO_SUPRESSAO
  ADITIVO_PRAZO_VALOR
  ADITIVO_QUALITATIVO
  ADITIVO_SUBROGACAO
  APOSTILAMENTO_REAJUSTE
  APOSTILAMENTO_REPACTUACAO
  APOSTILAMENTO_REEQUILIBRIO
  APOSTILAMENTO_DOTACAO
  APOSTILAMENTO_FISCALIZACAO
  APOSTILAMENTO_CORRECAO_MATERIAL
}

enum SituacaoAlteracao {
  MINUTA
  ASSINADO
  PUBLICADO
  CANCELADO
}

enum TipoEmpenho {
  ORDINARIO
  ESTIMATIVO
  GLOBAL
}

enum SituacaoEmpenho {
  EMITIDO
  LIQUIDADO
  PAGO
  ANULADO
}

enum SituacaoReserva {
  ATIVA
  BAIXADA
  CANCELADA
}

enum TipoAlerta {
  VENCIMENTO
  LIMITE_ACRESCIMO
  PRORROGACAO_ESGOTADA
  PUBLICACAO_PENDENTE
  GARANTIA_VENCENDO
  REAJUSTE_DEVIDO
  FORNECEDOR_SANCIONADO
}

enum SeveridadeAlerta {
  INFO
  ATENCAO
  CRITICO
}

enum SituacaoImportacao {
  RECEBIDO
  VALIDADO
  APLICADO
  REJEITADO
}

enum Role {
  LEITOR
  COLABORADOR
  FISCAL
  VISITANTE
  ANALISTA
  GESTOR
  ADMIN
}

model UnidadeFsp {
  id    String @id @default(uuid())
  sigla String @unique
  nome  String
}

model Municipio {
  id                   String                  @id @default(uuid())
  codigoIbge           String                  @unique
  nome                 String
  uf                   String
  regiaoAdministrativa String?
  unidades             UnidadeOrganizacional[]
  fornecedores         Fornecedor[]
  itensExecucao        ItemContrato[]          @relation("ItemMunicipioExecucao")

  @@index([uf, nome])
}

model Dominio {
  id                  String         @id @default(uuid())
  slug                String         @unique
  nome                String
  descricao           String?
  editavelPeloUsuario Boolean        @default(true)
  permiteHierarquia   Boolean        @default(false)
  valores             DominioValor[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model DominioValor {
  id           String         @id @default(uuid())
  dominioId    String
  dominio      Dominio        @relation(fields: [dominioId], references: [id], onDelete: Cascade)
  codigo       String
  label        String
  parentId     String?
  parent       DominioValor?  @relation("DominioValorHierarquia", fields: [parentId], references: [id])
  children     DominioValor[] @relation("DominioValorHierarquia")
  ordem        Int            @default(0)
  ativo        Boolean        @default(true)
  metadata     Json?
  codigoLegado String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  contratosCategoria   Contrato[]             @relation("ContratoCategoria")
  contratosModalidade  Contrato[]             @relation("ContratoModalidade")
  contratosFundamento  Contrato[]             @relation("ContratoFundamento")
  processosModalidade  ProcessoContratacao[]  @relation("ProcessoModalidade")
  catalogoPorCategoria CatalogoItem[]         @relation("CatalogoCategoria")
  catalogoUnidadeMedida CatalogoItem[]        @relation("CatalogoUnidadeMedida")
  atributosPorCategoria ItemAtributoDef[]     @relation("AtributoCategoria")
  itensUnidadeMedida   ItemContrato[]         @relation("ItemUnidadeMedida")
  alteracoesFundamento AlteracaoContratual[]  @relation("AlteracaoFundamento")
  dotacoesNatureza     DotacaoOrcamentaria[]  @relation("DotacaoNatureza")
  dotacoesFonte        DotacaoOrcamentaria[]  @relation("DotacaoFonte")
  publicacoesVeiculo   Publicacao[]           @relation("PublicacaoVeiculo")
  documentosTipo       Documento[]            @relation("DocumentoTipo")

  @@unique([dominioId, codigo])
  @@index([dominioId, ativo, ordem])
  @@index([parentId])
}

model Orgao {
  id         String                  @id @default(uuid())
  sigla      String                  @unique
  nome       String
  tipo       TipoOrgao
  ativo      Boolean                 @default(true)
  parentId   String?
  parent     Orgao?                  @relation("OrgaoHierarquia", fields: [parentId], references: [id])
  children   Orgao[]                 @relation("OrgaoHierarquia")
  unidades   UnidadeOrganizacional[]
  contratosGestora Contrato[]        @relation("ContratoUnidadeGestora")
  servidores Servidor[]
  usuarios   Usuario[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([parentId])
  @@index([ativo])
}

model UnidadeOrganizacional {
  id          String                  @id @default(uuid())
  orgaoId     String
  orgao       Orgao                   @relation(fields: [orgaoId], references: [id])
  parentId    String?
  parent      UnidadeOrganizacional?  @relation("UnidadeHierarquia", fields: [parentId], references: [id])
  children    UnidadeOrganizacional[] @relation("UnidadeHierarquia")
  sigla       String
  nome        String
  nivel       NivelUnidade?
  municipioId String?
  municipio   Municipio?              @relation(fields: [municipioId], references: [id])
  ativo       Boolean                 @default(true)
  servidores  Servidor[]
  contratosSubunidade Contrato[]      @relation("ContratoSubunidade")
  rateios     ContratoRateio[]
  processosDemandante ProcessoContratacao[] @relation("ProcessoUnidadeDemandante")
  itensDestino ItemContrato[]         @relation("ItemUnidadeDestino")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([orgaoId, sigla])
  @@index([parentId])
  @@index([municipioId])
  @@index([orgaoId, ativo])
}

model Fornecedor {
  id                 String              @id @default(uuid())
  tipoPessoa         TipoPessoa          @default(JURIDICA)
  documento          String              @unique
  razaoSocial        String
  nomeFantasia       String?
  inscricaoEstadual  String?
  porte              PorteEmpresa?
  municipioId        String?
  municipio          Municipio?          @relation(fields: [municipioId], references: [id])
  situacao           SituacaoFornecedor  @default(ATIVO)
  codigoLegado       String?
  contatos           FornecedorContato[]
  sancoes            FornecedorSancao[]
  contratos          Contrato[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([razaoSocial])
  @@index([situacao])
  @@index([municipioId])
}

model FornecedorContato {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  cargo        String?
  email        String?
  telefone     String?
  principal    Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
}

model FornecedorSancao {
  id           String     @id @default(uuid())
  fornecedorId String
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  tipo         TipoSancao
  processo     String?
  dataInicio   DateTime   @db.Date
  dataFim      DateTime?  @db.Date
  abrangencia  String?
  fonte        String?
  createdAt    DateTime   @default(now())

  @@index([fornecedorId])
  @@index([dataFim])
}

model Servidor {
  id           String                 @id @default(uuid())
  nome         String
  cpf          String?                @unique
  rgFuncional  String?                @unique
  cargo        String?
  orgaoId      String?
  orgao        Orgao?                 @relation(fields: [orgaoId], references: [id])
  unidadeId    String?
  unidade      UnidadeOrganizacional? @relation(fields: [unidadeId], references: [id])
  email        String?
  telefone     String?
  ativo        Boolean                @default(true)
  responsaveis ContratoResponsavel[]
  usuarios     Usuario[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([nome])
  @@index([orgaoId])
  @@index([unidadeId])
  @@index([ativo])
}

model ProcessoContratacao {
  id                       String                @id @default(uuid())
  eProtocolo               String                @unique
  ano                      Int
  objetoResumo             String
  unidadeDemandanteId      String
  unidadeDemandante        UnidadeOrganizacional @relation("ProcessoUnidadeDemandante", fields: [unidadeDemandanteId], references: [id])
  modalidadePretendidaId   String?
  modalidadePretendida     DominioValor?         @relation("ProcessoModalidade", fields: [modalidadePretendidaId], references: [id])
  valorEstimadoCents       BigInt?
  etpConcluido             Boolean               @default(false)
  dataEtp                  DateTime?             @db.Date
  termoReferenciaConcluido Boolean               @default(false)
  dataTermoReferencia      DateTime?             @db.Date
  situacao                 SituacaoProcesso      @default(PLANEJAMENTO)
  observacoes              String?
  contratos                Contrato[]
  reservas                 ReservaOrcamentaria[]
  documentos               Documento[]
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@index([ano])
  @@index([situacao])
}

model Contrato {
  id                       String                 @id @default(uuid())
  processoId               String?
  processo                 ProcessoContratacao?   @relation(fields: [processoId], references: [id])
  numeroGms                String
  anoGms                   Int
  numeroContrato           String?
  eProtocolo               String?                @unique
  pilar                    PilarOrcamentario
  categoriaContratacaoId   String
  categoriaContratacao     DominioValor           @relation("ContratoCategoria", fields: [categoriaContratacaoId], references: [id])
  naturezaObjeto           NaturezaObjeto
  modalidadeId             String
  modalidadeRef            DominioValor           @relation("ContratoModalidade", fields: [modalidadeId], references: [id])
  fundamentoLegalId        String?
  fundamentoLegal          DominioValor?          @relation("ContratoFundamento", fields: [fundamentoLegalId], references: [id])
  objeto                   String
  fornecedorId             String
  fornecedor               Fornecedor             @relation(fields: [fornecedorId], references: [id])
  /// Força ou SESP (unidade gestora administrativa)
  unidadeGestoraId         String
  unidadeGestora           Orgao                  @relation("ContratoUnidadeGestora", fields: [unidadeGestoraId], references: [id])
  /// Subunidade opcional (sede, CRPM, BBM, etc.)
  subunidadeId             String?
  subunidade               UnidadeOrganizacional? @relation("ContratoSubunidade", fields: [subunidadeId], references: [id])
  dataAssinatura           DateTime?              @db.Date
  dataInicioVigencia       DateTime               @db.Date
  prazoInicialValor        Int
  prazoInicialUnidade      UnidadeTempo           @default(MESES)
  dataFimVigenciaOriginal  DateTime               @db.Date
  prorrogavel              Boolean                @default(true)
  limiteProrrogacaoMeses   Int?
  valorGlobalOriginalCents BigInt
  indiceReajuste           String?
  mesAniversarioReajuste   Int?
  situacao                 SituacaoContrato       @default(EM_ELABORACAO)
  dataEncerramento         DateTime?              @db.Date
  motivoEncerramento       String?
  garantiaTipo             TipoGarantia?
  garantiaValorCents       BigInt?
  garantiaValidade         DateTime?              @db.Date
  reservaObservacao        String?
  observacoes              String?
  codigoLegado             String?
  responsaveis             ContratoResponsavel[]
  rateios                  ContratoRateio[]
  itens                    ItemContrato[]
  alteracoes               AlteracaoContratual[]
  dotacoes                 ContratoDotacao[]
  empenhos                 Empenho[]
  reservas                 ReservaOrcamentaria[]
  publicacoes              Publicacao[]
  documentos               Documento[]
  alertas                  Alerta[]
  criadoPorId              String?
  criadoPor                Usuario?               @relation("ContratoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoPorId          String?
  atualizadoPor            Usuario?               @relation("ContratoAtualizadoPor", fields: [atualizadoPorId], references: [id])
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@unique([numeroGms, anoGms])
  @@index([situacao, dataFimVigenciaOriginal])
  @@index([unidadeGestoraId])
  @@index([subunidadeId])
  @@index([fornecedorId])
  @@index([pilar, categoriaContratacaoId])
  @@index([anoGms])
  @@index([modalidadeId])
  @@index([criadoPorId])
  @@index([atualizadoPorId])
  @@index([createdAt])
  @@index([dataAssinatura])
  @@index([garantiaValidade])
  @@index([processoId])
}

model ContratoResponsavel {
  id             String           @id @default(uuid())
  contratoId     String
  contrato       Contrato         @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  servidorId     String
  servidor       Servidor         @relation(fields: [servidorId], references: [id])
  papel          PapelResponsavel
  atoDesignacao  String?
  dataInicio     DateTime         @db.Date
  dataFim        DateTime?        @db.Date
  createdAt      DateTime         @default(now())

  @@index([contratoId])
  @@index([servidorId, papel])
}

model ContratoRateio {
  id          String                 @id @default(uuid())
  contratoId  String
  contrato    Contrato               @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  unidadeId   String
  unidade     UnidadeOrganizacional  @relation(fields: [unidadeId], references: [id])
  percentual  Decimal?               @db.Decimal(7, 4)
  valorCents  BigInt?
  quantidade  Decimal?               @db.Decimal(14, 4)
  observacao  String?
  createdAt   DateTime               @default(now())

  @@unique([contratoId, unidadeId])
  @@index([unidadeId])
}

model AlteracaoContratual {
  id                       String             @id @default(uuid())
  contratoId               String
  contrato                 Contrato           @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipo                     TipoAlteracao
  numero                   Int
  eProtocolo               String?
  objetoDescricao          String
  fundamentoLegalId        String?
  fundamentoLegal          DominioValor?      @relation("AlteracaoFundamento", fields: [fundamentoLegalId], references: [id])
  justificativa            String?
  justificativaExcepcional String?
  dataAssinatura           DateTime           @db.Date
  dataInicioEfeito         DateTime?          @db.Date
  prazoAcrescidoValor      Int?
  prazoAcrescidoUnidade    UnidadeTempo?
  novaDataFimVigencia      DateTime?          @db.Date
  valorAcrescidoCents      BigInt             @default(0)
  valorSuprimidoCents      BigInt             @default(0)
  percentualReajuste       Decimal?           @db.Decimal(7, 4)
  situacao                 SituacaoAlteracao  @default(MINUTA)
  codigoLegado             String?
  itens                    AlteracaoItem[]
  publicacoes              Publicacao[]
  documentos               Documento[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@unique([contratoId, tipo, numero])
  @@index([contratoId, situacao])
  @@index([dataAssinatura])
}

model AlteracaoItem {
  id                     String               @id @default(uuid())
  alteracaoId            String
  alteracao              AlteracaoContratual  @relation(fields: [alteracaoId], references: [id], onDelete: Cascade)
  itemContratoId         String?
  itemContrato           ItemContrato?        @relation(fields: [itemContratoId], references: [id])
  catalogoItemId         String?
  catalogoItem           CatalogoItem?        @relation(fields: [catalogoItemId], references: [id])
  quantidadeDelta        Decimal              @db.Decimal(14, 4)
  valorUnitarioNovoCents BigInt?
  observacao             String?
  createdAt              DateTime             @default(now())

  @@index([alteracaoId])
  @@index([itemContratoId])
}

model CatalogoItem {
  id                     String        @id @default(uuid())
  categoriaItemId        String
  categoriaItem          DominioValor  @relation("CatalogoCategoria", fields: [categoriaItemId], references: [id])
  codigo                 String?
  nome                   String
  descricao              String?
  unidadeMedidaPadraoId  String
  unidadeMedidaPadrao    DominioValor  @relation("CatalogoUnidadeMedida", fields: [unidadeMedidaPadraoId], references: [id])
  atributosPadrao        Json?
  ativo                  Boolean       @default(true)
  itensContrato          ItemContrato[]
  alteracaoItens         AlteracaoItem[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([categoriaItemId, nome])
  @@index([nome])
  @@index([ativo])
}

model ItemAtributoDef {
  id               String       @id @default(uuid())
  categoriaItemId  String
  categoriaItem    DominioValor @relation("AtributoCategoria", fields: [categoriaItemId], references: [id])
  chave            String
  label            String
  tipo             TipoAtributo
  dominioSlug      String?
  obrigatorio      Boolean      @default(false)
  unidade          String?
  ordem            Int          @default(0)
  ajuda            String?
  ativo            Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([categoriaItemId, chave])
  @@index([categoriaItemId, ativo, ordem])
}

model ItemContrato {
  id                    String                 @id @default(uuid())
  contratoId            String
  contrato              Contrato               @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  sequencia             Int
  catalogoItemId        String
  catalogoItem          CatalogoItem           @relation(fields: [catalogoItemId], references: [id])
  descricaoComplementar String?
  quantidade            Decimal                @db.Decimal(14, 4)
  unidadeMedidaId       String
  unidadeMedida         DominioValor           @relation("ItemUnidadeMedida", fields: [unidadeMedidaId], references: [id])
  valorUnitarioCents    BigInt
  periodicidade         Periodicidade          @default(UNICA)
  unidadeDestinoId      String?
  unidadeDestino        UnidadeOrganizacional? @relation("ItemUnidadeDestino", fields: [unidadeDestinoId], references: [id])
  municipioExecucaoId   String?
  municipioExecucao     Municipio?             @relation("ItemMunicipioExecucao", fields: [municipioExecucaoId], references: [id])
  enderecoExecucao      String?
  atributos             Json?
  alteracaoItens        AlteracaoItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([contratoId, sequencia])
  @@index([catalogoItemId])
  @@index([unidadeDestinoId])
}

model DotacaoOrcamentaria {
  id                   String            @id @default(uuid())
  exercicio            Int
  codigo               String
  unidadeOrcamentaria  String?
  funcionalProgramatica String?
  naturezaDespesaId    String
  naturezaDespesa      DominioValor      @relation("DotacaoNatureza", fields: [naturezaDespesaId], references: [id])
  fonteRecursoId       String
  fonteRecurso         DominioValor      @relation("DotacaoFonte", fields: [fonteRecursoId], references: [id])
  descricao            String?
  contratos            ContratoDotacao[]
  empenhos             Empenho[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@unique([exercicio, codigo])
  @@index([fonteRecursoId])
  @@index([naturezaDespesaId])
}

model ContratoDotacao {
  id                 String              @id @default(uuid())
  contratoId         String
  contrato           Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  dotacaoId          String
  dotacao            DotacaoOrcamentaria @relation(fields: [dotacaoId], references: [id])
  exercicio          Int
  valorPrevistoCents BigInt
  createdAt          DateTime            @default(now())

  @@unique([contratoId, dotacaoId, exercicio])
  @@index([dotacaoId])
}

model Empenho {
  id                  String              @id @default(uuid())
  contratoId          String
  contrato            Contrato            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  dotacaoId           String?
  dotacao             DotacaoOrcamentaria? @relation(fields: [dotacaoId], references: [id])
  numero              String
  exercicio           Int
  tipo                TipoEmpenho         @default(ORDINARIO)
  data                DateTime            @db.Date
  valorCents          BigInt
  valorLiquidadoCents BigInt              @default(0)
  valorPagoCents      BigInt              @default(0)
  situacao            SituacaoEmpenho     @default(EMITIDO)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([numero, exercicio])
  @@index([contratoId])
  @@index([dotacaoId])
}

model ReservaOrcamentaria {
  id          String                 @id @default(uuid())
  contratoId  String?
  contrato    Contrato?              @relation(fields: [contratoId], references: [id], onDelete: SetNull)
  processoId  String?
  processo    ProcessoContratacao?   @relation(fields: [processoId], references: [id], onDelete: SetNull)
  numero      String
  data        DateTime               @db.Date
  valorCents  BigInt
  situacao    SituacaoReserva        @default(ATIVA)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([contratoId])
  @@index([processoId])
  @@index([numero])
}

model Publicacao {
  id             String               @id @default(uuid())
  contratoId     String?
  contrato       Contrato?            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  alteracaoId    String?
  alteracao      AlteracaoContratual? @relation(fields: [alteracaoId], references: [id], onDelete: Cascade)
  veiculoId      String
  veiculo        DominioValor         @relation("PublicacaoVeiculo", fields: [veiculoId], references: [id])
  dataPublicacao DateTime             @db.Date
  numeroEdicao   String?
  idPncp         String?
  url            String?
  createdAt      DateTime             @default(now())

  @@index([dataPublicacao])
  @@index([contratoId])
  @@index([alteracaoId])
}

model Documento {
  id              String               @id @default(uuid())
  contratoId      String?
  contrato        Contrato?            @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  alteracaoId     String?
  alteracao       AlteracaoContratual? @relation(fields: [alteracaoId], references: [id], onDelete: Cascade)
  processoId      String?
  processo        ProcessoContratacao? @relation(fields: [processoId], references: [id], onDelete: Cascade)
  tipoDocumentoId String
  tipoDocumento   DominioValor         @relation("DocumentoTipo", fields: [tipoDocumentoId], references: [id])
  nome            String
  storageKey      String?
  urlExterna      String?
  mimeType        String?
  tamanhoBytes    Int?
  uploadedById    String?
  createdAt       DateTime             @default(now())

  @@index([contratoId])
  @@index([alteracaoId])
  @@index([processoId])
  @@index([tipoDocumentoId])
}

model AlertaConfig {
  id            String      @id @default(uuid())
  tipo          TipoAlerta  @unique
  janelasDias   Int[]
  ativo         Boolean     @default(true)
  destinatarios Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Alerta {
  id               String           @id @default(uuid())
  contratoId       String
  contrato         Contrato         @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  tipo             TipoAlerta
  severidade       SeveridadeAlerta @default(ATENCAO)
  janelaDias       Int?
  mensagem         String
  dataReferencia   DateTime         @db.Date
  reconhecidoPorId String?
  reconhecidoEm    DateTime?
  resolvidoEm      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([contratoId, tipo, dataReferencia])
  @@index([tipo, severidade])
  @@index([contratoId])
  @@index([reconhecidoEm])
}

model ImportacaoLote {
  id             String             @id @default(uuid())
  nomeArquivo    String
  tipoEntidade   String
  situacao       SituacaoImportacao @default(RECEBIDO)
  totalLinhas    Int                @default(0)
  linhasValidas  Int                @default(0)
  linhasComErro  Int                @default(0)
  executadoPorId String?
  dryRun         Boolean            @default(true)
  resumo         Json?
  linhas         ImportacaoLinha[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([tipoEntidade, situacao])
  @@index([createdAt])
}

model ImportacaoLinha {
  id                String         @id @default(uuid())
  loteId            String
  lote              ImportacaoLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  numeroLinha       Int
  payloadOriginal   Json
  payloadNormalizado Json?
  erros             Json?
  registroCriadoId  String?
  createdAt         DateTime       @default(now())

  @@index([loteId, numeroLinha])
}

model AuditLog {
  id         String   @id @default(uuid())
  tabela     String
  registroId String
  action     String
  diff       Json
  changedBy  String?
  source     String?
  requestId  String?
  changedAt  DateTime @default(now())

  @@index([tabela, registroId])
  @@index([changedAt])
}

model Usuario {
  id           String    @id @default(uuid())
  sub          String?   @unique
  email        String?   @unique
  nome         String?
  passwordHash String?
  role         Role      @default(ANALISTA)
  servidorId   String?
  servidor     Servidor? @relation(fields: [servidorId], references: [id])
  orgaoId      String?
  orgao        Orgao?    @relation(fields: [orgaoId], references: [id])
  ativo        Boolean   @default(true)
  contratosCriados     Contrato[] @relation("ContratoCriadoPor")
  contratosAtualizados Contrato[] @relation("ContratoAtualizadoPor")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role, ativo])
  @@index([orgaoId])
  @@index([servidorId])
}
