    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pdfkit": "^0.19.1",
    "serverless-http": "^4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
