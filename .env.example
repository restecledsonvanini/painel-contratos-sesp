# =============================================================================
# painel-contratos-sesp — desenvolvimento (Windows + Codespaces)
# Copie para .env na raiz:  cp .env.example .env
# Setup automático:        npm run setup
# =============================================================================

# Postgres local (Docker Compose em apps/docker — porta 5434)
DATABASE_URL="postgresql://painel:pass@localhost:5434/painel_db"

# API (opcional; default 8888)
# PORT=8888

# Web (opcional; default usa proxy Vite → API)
# VITE_API_URL=/api/v1

# --- Auth (API + Web devem casar) ---
# Desligado = bypass dev (usuário sistema ADMIN na API; UI liberada).
# AUTH_REQUIRED=1
# VITE_AUTH_REQUIRED=1

# Domínios de e-mail no login (sobrescreve seed). Use * em dev/teste.
# AUTH_EMAIL_DOMAINS=sesp.pr.gov.br,pm.pr.gov.br
# AUTH_EMAIL_DOMAINS=*

# JWT (obrigatório se AUTH_REQUIRED=1 em produção)
# JWT_SECRET=altere-me
# JWT_TTL_SEC=43200
