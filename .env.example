# Exemplo de DATABASE_URL para desenvolvimento local com docker do projeto
# Compose mapeia o container em localhost:5434 (evita conflito com outros Postgres em :5432)
DATABASE_URL="postgresql://painel:pass@localhost:5434/painel_db"

# Quando usar um container em outro host/porta, ajuste conforme necessário
# DATABASE_URL="postgresql://painel:pass@localhost:5432/painel_db"

# --- Auth (API + Web devem casar) ---
# Sem estes flags = bypass de desenvolvimento (papel ANALISTA sintético).
# AUTH_REQUIRED=1
# VITE_AUTH_REQUIRED=1

# Domínios de e-mail permitidos no login (sobrescreve lista do domínio seed).
# AUTH_EMAIL_DOMAINS=sesp.pr.gov.br,pm.pr.gov.br

# Segredo JWT (obrigatório em produção com AUTH_REQUIRED).
# JWT_SECRET=altere-me
