# =============================================================================
# painel-contratos-sesp — desenvolvimento (Windows + Codespaces)
# Copie para .env na raiz:  cp .env.example .env
# Setup automático:        npm run setup
# =============================================================================

# Postgres local (Docker Compose em apps/docker — porta 5434)
# Prisma 7 lê esta URL em packages/db/prisma.config.ts (saiu do schema.prisma).
DATABASE_URL="postgresql://painel:pass@localhost:5434/painel_db"

# API (opcional; default 8888)
# PORT=8888

# Web (opcional; default usa proxy Vite → API)
# VITE_API_URL=/api/v1

# --- Auth (API + Web devem casar) ---
# Exige token em toda requisição. Ligue junto com VITE_AUTH_REQUIRED.
# AUTH_REQUIRED=1
# VITE_AUTH_REQUIRED=1

# Bypass de desenvolvimento: sem header Authorization a API responde como ADMIN.
# Opt-in explícito, ignorado quando AUTH_REQUIRED=1 e indisponível em produção.
AUTH_DEV_BYPASS=1

# Domínios de e-mail no login (sobrescreve seed). Use * em dev/teste.
# AUTH_EMAIL_DOMAINS=sesp.pr.gov.br,pm.pr.gov.br
# AUTH_EMAIL_DOMAINS=*

# JWT — obrigatório em produção (mínimo 32 caracteres; a API não sobe sem ele).
# JWT_SECRET=altere-me
# JWT_TTL_SEC=43200

# --- Endurecimento HTTP ---
# Origens liberadas no CORS. Vazio = nenhum header CORS (padrão).
# Só é necessário se o front for servido de outra origem que não a da API.
# CORS_ORIGINS=https://painel.sesp.pr.gov.br

# Confiar em X-Forwarded-For (nº de proxies à frente). Sem proxy, deixe desligado:
# confiar sem proxy deixa o cliente forjar o IP e escapar do rate limit.
# Default: desligado em dev, 1 em produção.
# TRUST_PROXY=1

# Tentativas de login malsucedidas por IP+e-mail a cada 15 min (default 10).
# Login que dá certo não consome cota.
# AUTH_LOGIN_RATE_MAX=10

# Tempo máximo para receber uma requisição (default 60000).
# REQUEST_TIMEOUT_MS=60000
